#!/bin/bash
set -euo pipefail

swift --version

swift package \
    dollup --allow-writing-to-package-directory
swift package --package-path Benchmarks \
    dollup --allow-writing-to-package-directory
git diff --exit-code

swift build -c release \
    --explicit-target-dependency-import-check=warn \
    --build-tests

swift test -c release \
    --skip-build \
    --explicit-target-dependency-import-check=warn
